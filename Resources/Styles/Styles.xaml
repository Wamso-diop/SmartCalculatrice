<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="BgMain">#0F0E1F</Color>
    <Color x:Key="BgSecondary">#1A1830</Color>
    <Color x:Key="BtnDigit">#232140</Color>
    <Color x:Key="BtnFunction">#2F2B52</Color>
    <Color x:Key="BtnOperator">#FF6B00</Color>
    <Color x:Key="BtnScientific">#7C3AED</Color>
    <Color x:Key="BtnEquals">#FFB020</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#9D97C9</Color>
    <Color x:Key="BorderColor">#3A3560</Color>

    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
    </Style>

    <Style x:Key="DigitButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BtnDigit}" />
    </Style>

    <Style x:Key="FunctionButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BtnFunction}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BtnOperator}" />
    </Style>

    <Style x:Key="ScientificButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BtnScientific}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style x:Key="EqualsButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource BtnEquals}" />
    </Style>

</ResourceDictionary>